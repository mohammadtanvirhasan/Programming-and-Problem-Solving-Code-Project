#include <stdio.h>
#include <string.h>
int main()
{
    char a[100001] ;
    scanf("%s", a) ;
    for(int i = 0;i < strlen(a);i++)
    {
       if(a[i] == ',')
       {
          a[i] = ' ' ;
       }
       else
       {
          if(a[i] >= 'a' && a[i] <= 'z')
          {
             a[i] = a[i] - ('a' - 'A') ;
          }
          else
          {
             a[i] = a[i] + ('a' - 'A') ;
          }
       }
    }
    printf("%s", a) ;
 
    return 0;
}
