#include <stdio.h>
#include <string.h>
int main()
{
    char a[1001] ;
    scanf("%s", a) ;
    int man = 0, b = strlen(a) - 1 ;
    for(int i = 0;i < strlen(a)/2;i++){
       if(a[i] != a[b])
       {
          man = 1 ;
          break ;
       }
       b--;
    }
    if(man == 1)
    {
       printf("NO") ;
    }
    else
    {
       printf("YES") ;
    }
    
    return 0;
}
