#include <stdio.h>
int main(){
int n ;
scanf("%d", &n) ;
int a[n] ;

//Reading the elements of the array
for(int i = 0;i < n;i++){
    scanf("%d", &a[i]) ;
}

int even = 0, odd = 0 ;

//counting even & odd elements
for(int i = 0;i < n;i++){
        if(a[i] % 2 == 0){
            even++ ;
        }
        else{
            odd++ ;
        }
}


//printing the results
printf("%d %d", even, odd) ;
return 0 ;
}
