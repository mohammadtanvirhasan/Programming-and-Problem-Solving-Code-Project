#include <stdio.h>
//Function to print numbers
void printNumbers(int n){
for(int i = 1;i  <= n;i++){
    printf("%d", i) ;
    if(i < n){
       printf(" ") ;//Print a space only between two numbers
    }
}
}
int main(){
int n ;
scanf("%d", &n) ;  //Read the value of N from input
printNumbers(n);//call the function to print numbers from 1 to N
 
return 0 ;
 
}
