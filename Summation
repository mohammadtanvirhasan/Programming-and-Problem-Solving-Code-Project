#include <stdio.h>
int main()
{
   long long int n, sum = 0 ;
   scanf("%lld", &n) ;
   int ar[n] ;
   for(int i = 0;i < n;i++){
      scanf("%d", &ar[i]) ;
   }
   
   for(int i = 0;i < n;i++){
      sum = sum + ar[i] ;
   }
   if(sum < 0){
      sum = -1 * sum ;
      
   }
   
   printf("%lld\n", sum) ;
   
   return 0;
}
